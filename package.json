{
  "name": "instar-plugin",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/openspec-min"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build --workspace openspec-min && node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "sync:templates": "node scripts/sync-templates.mjs",
    "check:templates": "node scripts/sync-templates.mjs --check",
    "test": "npm run build && npm run check && node scripts/run-tests.mjs",
    "test:fast": "node scripts/run-tests.mjs --fast",
    "release": "npm test && node scripts/release.mjs && npm run test:release && npm run test:host",
    "test:release": "node scripts/smoke-release.mjs",
    "test:host": "node scripts/smoke-host.mjs",
    "test:windows": "node scripts/smoke-windows.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.9.0"
  }
}
