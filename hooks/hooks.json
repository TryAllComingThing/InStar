{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/quality-hook.mjs\"",
            "timeout": 1800,
            "statusMessage": "InStar Bash preflight"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/quality-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "InStar session audit"
          }
        ]
      }
    ]
  }
}
